# =============================================================================
# Hair Studio – Production deployment
# =============================================================================
# Copy to .env.local for local dev. In production (e.g. Vercel), set these
# in the dashboard. Never commit .env or .env.local.
# =============================================================================

# Site URL – used for metadata, Open Graph, canonical URL, sitemap, JSON-LD, www→apex redirect
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# SEO: add public/images/og-social.jpg (1200×630 px) for best social previews. See app/lib/seo.ts.

# NextAuth – use apex URL (same as site URL), never www, to avoid redirect loops
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=
# Generate: openssl rand -base64 32

# Admin login (Credentials provider)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Firebase – from Firebase Console → Project settings
# In Auth → Authorized domains, add your production domain (and www)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Resend – use verified domain for sending
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-domain.com
ADMIN_EMAIL_NOTIFICATION=
